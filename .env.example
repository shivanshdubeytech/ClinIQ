GROQ_API_KEY=
LLM_MODEL_NAME=llama-3.1-8b-instant
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE=250
CHUNK_OVERLAP=30
CONFIDENCE_THRESHOLD=0.6
CHROMA_DB_PATH=./chroma_db
SQLITE_DB_PATH=./cliniq.db
AUDIO_DIR=./static/audio
LOG_LEVEL=INFO
FLASK_DEBUG=0
# Optional comma-separated Groq API keys for automatic rotation
GROQ_API_KEYS=
# Server host binding (defaults to 127.0.0.1)
HOST=127.0.0.1
# Server listening port (defaults to 8501)
PORT=8501
